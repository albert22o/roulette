      \u0432 \u043A\u0440\u0430\u0441\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 292544624
    m_Localized: "\u0424\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439 \u043F\u043B\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 292544625
    m_Localized: "\u041F\u0435\u0440\u0435\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E
      \u0432 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439. \u041D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043A \u043C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044E
      3.\n\u041F\u0440\u0438 \u0432\u044B\u043F\u0430\u0434\u0435\u043D\u0438\u0438
      \u0448\u0430\u0440\u0438\u043A\u0430 \u043D\u0430 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439
      \u0446\u0432\u0435\u0442 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0448
      \u0441\u0442\u0430\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 292544626
    m_Localized: "\u0411\u0435\u043B\u044B\u0439 \u043F\u043B\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 292544627
    m_Localized: "\u041F\u0435\u0440\u0435\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0434\u0432\u0430 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0445 \u0447\u0438\u0441\u043B\u0430
      \u0432 \u0431\u0435\u043B\u044B\u0439.\n\u0415\u0441\u043B\u0438 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
      \u0448\u0430\u0440, \u0432\u044B\u043F\u0430\u0432\u0448\u0438\u0439 \u043D\u0430
      \u0431\u0435\u043B\u044B\u0439 \u0446\u0432\u0435\u0442, \u043A\u0432\u043E\u0442\u0430
      \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0431\u0435\u043B\u0430\u044F \u043A\u043B\u0435\u0442\u043A\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0439 \u0446\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 292544628
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0432\u0430
      \u043F\u043E\u043B\u044F \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043A\u0440\u0430\u0441\u043A\u0438
      \u0432 \u0431\u0435\u043B\u044B\u0439"
    m_Metadata:
      m_Items: []
