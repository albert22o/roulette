  - m_Id: 934273070
    m_Localized: "3-\u044F \u0434\u044E\u0436\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 934273071
    m_Localized: "\u0421\u0422\u0410\u0412\u041A\u0418:"
    m_Metadata:
      m_Items: []
  - m_Id: 934273072
    m_Localized: "\u0428\u0422\u0420\u0410\u0424 \u0417\u0410 \u0420\u0415\u0420\u041E\u041B\u041B:"
    m_Metadata:
      m_Items: []
  - m_Id: 934273073
    m_Localized: "\u0420\u0435\u0440\u043E\u043B\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 934273074
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 934273075
    m_Localized: "\u041A\u0440\u0443\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 934273076
    m_Localized: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 934273077
    m_Localized: "\u0417\u0430\u0431\u0440\u0430\u0442\u044C \u0432\u044B\u0438\u0433\u0440\u044B\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 934273078
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 934273079
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 1 \u0447\u0438\u0441\u043B\u043E
      \u0434\u043B\u044F \u0437\u0430\u043C\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 934273080
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 3 \u0447\u0438\u0441\u043B\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C
      \u043D\u0430 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 934273081
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 3 \u0447\u0438\u0441\u043B\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C
      \u043D\u0430 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 934273082
    m_Localized: "\u0412\u044B \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 934273083
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 934273084
    m_Localized: "\u041F\u0440\u043E\u0439\u0434\u0435\u043D\u043E \u043A\u0432\u043E\u0442:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 934273085
    m_Localized: "\u0422\u0435\u043A\u0443\u0449\u0430\u044F \u043A\u0432\u043E\u0442\u0430:
      {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 934273086
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 x{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 934273087
    m_Localized: '{0} (x{1})'
    m_Metadata:
      m_Items: []
  - m_Id: 934273088
    m_Localized: "\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 934273089
    m_Localized: "\u0414\u0435\u043B\u0430\u0439\u0442\u0435 \u0441\u0442\u0430\u0432\u043A\u0443
      (\u041B\u041A\u041C)"
    m_Metadata:
      m_Items: []
  - m_Id: 934273090
    m_Localized: "\u0414\u0435\u043B\u0430\u044F \u0441\u0442\u0430\u0432\u043A\u0443
      \u043D\u0430 \u0447\u0438\u0441\u043B\u043E, \u0432\u044B \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u0434\u0435\u043B\u0430\u0435\u0442\u0435 \u0441\u0442\u0430\u0432\u043A\u0443
      \u043D\u0430 \u0434\u044E\u0436\u0438\u043D\u0443, \u0446\u0432\u0435\u0442
      \u0438 \u0447\u0438\u0441\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 934273091
    m_Localized: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0438\u0437
      \u044D\u0442\u0438\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432
      \u0441\u0432\u043E\u0439 \u043C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 934273092
    m_Localized: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C
      \u0441\u0442\u0430\u0432\u043A\u0443 (\u041F\u041A\u041C)"
    m_Metadata:
      m_Items: []
  - m_Id: 934273093
    m_Localized: "\u0412\u0430\u0448\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u2013
      \u043F\u043E\u0431\u0438\u0442\u044C \u043A\u0432\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 934273094
    m_Localized: "\u041A\u0440\u0443\u0442\u0438\u0442\u0435 \u0440\u0443\u043B\u0435\u0442\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 934273095
    m_Localized: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0441\u0442\u0430\u0432\u043A\u0443, \u043D\u0430\u0436\u0430\u0432 \u043D\u0430
      \u0448\u0430\u0440\u0438\u043A \u0438\u043B\u0438 \u043A\u0440\u0443\u0442\u0438\u0442\u044C
      \u0437\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 934273096
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0440\u0435\u0440\u043E\u043B\u043B
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0439, \u043F\u043E\u0441\u043B\u0435
      \u044D\u0442\u043E\u0433\u043E \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435
      \u0442\u0435\u0440\u044F\u0442\u044C 25% \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u0430
      \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435 \u043D\u043E\u0432\u043E\u0435
      \u043A\u0440\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 934273097
    m_Localized: "\u0412\u044B \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0438,
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0441\u0442\u0430\u0432\u043A\u0443, \u043D\u0430\u0436\u0430\u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E
      \u043A\u043D\u043E\u043F\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 934273098
    m_Localized: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043C\u0430\u0433\u0430\u0437\u0438\u043D,
      \u0442\u0430\u043C \u043C\u043E\u0436\u043D\u043E \u043A\u0443\u043F\u0438\u0442\u044C
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 934273099
    m_Localized: "\u0417\u0430 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435
      \u0437\u043E\u043B\u043E\u0442\u044B\u0435 \u0444\u0438\u0448\u043A\u0438 \u043C\u043E\u0436\u043D\u043E
      \u043A\u0443\u043F\u0438\u0442\u044C \u043E\u0441\u043E\u0431\u044B\u0435 \u0444\u0438\u0448\u043A\u0438,
